{
  "name": "@netscry/docs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "blume dev --host 127.0.0.1 --port 4321",
    "api:generate": "bun scripts/generate-api-openapi.ts --write",
    "api:check": "bun scripts/generate-api-openapi.ts --check",
    "build": "bun run api:check && blume build --isolated",
    "check": "bun run api:check && blume check",
    "doctor": "blume doctor",
    "validate": "blume validate"
  },
  "dependencies": {
    "@netscry/schemas": "workspace:*",
    "blume": "^2.2.6",
    "effect": "4.0.6",
    "oxfmt": "^0.74.0"
  }
}
