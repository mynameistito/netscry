{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "netscry",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "module": "index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev": "concurrently --kill-others --names web,docs \"bun --filter @netscry/web dev\" \"bun --filter @netscry/docs dev\"",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "test": "vitest run",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.84",
    "@shadcn/lint": "^0.2.3",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "alchemy": "2.0.0-beta.84",
    "concurrently": "^10.0.6",
    "eslint-plugin-github": "6.1.2",
    "eslint-plugin-jsdoc": "^65.4.2",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-tsdoc": "^0.5.4",
    "jsdom": "^30.1.3",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-plugin-react-doctor": "^0.9.18",
    "oxlint-tsgolint": "^7.0.2005",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "ultracite": "8.1.0",
    "vitest": "5.0.5"
  },
  "packageManager": "bun@1.4.4"
}
