{
  "name": "netscry",
  "version": "0.1.0",
  "homepage": "https://github.com/mynameistito/netscry#readme",
  "bugs": {
    "url": "https://github.com/mynameistito/netscry/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mynameistito/netscry.git",
    "directory": "packages/netscry"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "bun": "./src/core.ts",
      "development": "./src/core.ts",
      "import": "./dist/core.js",
      "default": "./dist/core.js"
    },
    "./schemas": {
      "types": "./dist/schemas.d.ts",
      "bun": "./src/schemas.ts",
      "development": "./src/schemas.ts",
      "import": "./dist/schemas.js",
      "default": "./dist/schemas.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test:consumer": "node test/consumer.mjs"
  },
  "dependencies": {
    "@netscry/core": "^0.1.1",
    "@netscry/schemas": "^0.1.1",
    "@netscry/sdk": "^0.1.1"
  },
  "engines": {
    "node": ">=20"
  }
}
